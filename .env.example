# Ollama's OpenAI-compatible API root (without /v1).
SKYLINEE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Set this before exposing the harness beyond localhost.
SKYLINEE_API_KEY=replace-with-a-long-random-value

# Example low-footprint defaults. Replace them with models available in Ollama.
SKYLINEE_MODEL_GENERAL=qwen2.5:1.5b
SKYLINEE_MODEL_CODE=deepseek-coder:1.3b
SKYLINEE_MODEL_SECURITY=qwen2.5:1.5b

SKYLINEE_REQUEST_TIMEOUT_SECONDS=180
SKYLINEE_AUDIT_LOG_PATH=/data/audit.jsonl
SKYLINEE_LOG_PROMPT_CONTENT=false
